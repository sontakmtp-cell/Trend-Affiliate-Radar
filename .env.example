# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PUBLIC_BASE_URL: Set to your public VPS/Cloud domain to enable URL Redirect Click Tracking.
# Leave empty in local mode to use standard Sub_id / UTM tracking.
PUBLIC_BASE_URL=

# XHS_MCP_URL: Optional Xiaohongshu MCP host bridge URL (e.g. http://host.docker.internal:18060)
XHS_MCP_URL=

# ADMIN_PASSCODE: Optional server-side admin passcode for protected deployments.
ADMIN_PASSCODE=

